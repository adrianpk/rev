;; -*- lexical-binding: t; -*-
(require 'json)
(require 'elec-pair)
(require 'lisp-mode)
(require 'cc-mode)
(defun pair-probe (name mode source offset keys &optional mark-offset)
  (save-window-excursion
    (with-temp-buffer
      (funcall mode)
      (electric-pair-local-mode 1)
      (insert source)
      (goto-char (1+ offset))
      (setq-local transient-mark-mode t)
      (when mark-offset (set-mark (1+ mark-offset)) (activate-mark))
      (set-window-buffer (selected-window) (current-buffer))
      (let ((inhibit-message t) (ring-bell-function #'ignore) issue)
        (condition-case err (execute-kbd-macro (kbd keys))
          (error (setq issue (error-message-string err))))
        `((case . ,name) (mode . ,(symbol-name mode)) (initial . ,source)
          (point_before . ,offset) (mark_before . ,mark-offset) (keys . ,keys)
          (text . ,(buffer-string)) (point . ,(1- (point)))
          (mark . ,(when (mark t) (1- (mark t))))
          (active_region . ,(if (use-region-p) t :json-false)) (error . ,issue))))))
;; Run: emacs --batch -Q --load ops/default/report/rev-delimiter-editing/reference-editing.el
(princ (json-encode
 `((version . ,emacs-version)
   (cases . ,(vector
     (pair-probe "open" 'emacs-lisp-mode "" 0 "(")
     (pair-probe "counted_open" 'emacs-lisp-mode "" 0 "C-u 3 (")
     (pair-probe "skip_close" 'emacs-lisp-mode "()" 1 ")")
     (pair-probe "delete_empty" 'emacs-lisp-mode "()" 1 "DEL")
     (pair-probe "delete_space" 'emacs-lisp-mode "( )" 2 "DEL")
     (pair-probe "wrap_forward" 'emacs-lisp-mode "alpha" 5 "(" 0)
     (pair-probe "wrap_backward" 'emacs-lisp-mode "alpha" 0 "(" 5)
     (pair-probe "wrap_closer" 'emacs-lisp-mode "alpha" 5 ")" 0)
     (pair-probe "apostrophe" 'text-mode "dont" 3 "'")
     (pair-probe "wrap_counted" 'emacs-lisp-mode "alpha" 5 "C-u 3 (" 0)
     (pair-probe "literal_count_negative" 'emacs-lisp-mode "" 0 "C-u -1 (")
     (pair-probe "open_before_close" 'emacs-lisp-mode ")" 0 "("))))))
(terpri)
