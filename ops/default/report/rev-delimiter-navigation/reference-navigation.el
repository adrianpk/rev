(require 'json)
(require 'lisp-mode)
(require 'cc-mode)
(require 'js)
(require 'css-mode)
(require 'sgml-mode)
(require 'org)
(defun navigation-probe (item)
  (pcase-let ((`(,name ,mode ,source ,offset ,keys . ,options) item))
    (save-window-excursion
      (with-temp-buffer
        (funcall mode)
        (insert source)
        (goto-char (1+ offset))
        (setq-local transient-mark-mode t)
        (let ((mark-offset (plist-get options :mark)))
          (when mark-offset (set-mark (1+ mark-offset)) (activate-mark)))
        (when (plist-get options :readonly) (setq buffer-read-only t))
        (set-window-buffer (selected-window) (current-buffer))
        (let ((inhibit-message t) (ring-bell-function #'ignore) issue)
          (condition-case err (execute-kbd-macro (kbd keys))
            (error (setq issue (error-message-string err))))
          (unless (equal source (buffer-string)) (error "Motion modified source"))
          `((case . ,name) (mode . ,(symbol-name mode)) (initial . ,source)
            (point_before . ,offset) (mark_before . ,(plist-get options :mark))
            (active_before . ,(if (plist-get options :mark) t :json-false))
            (read_only . ,(if buffer-read-only t :json-false)) (keys . ,keys)
            (text . ,(buffer-string)) (point . ,(1- (point)))
            (mark . ,(when (mark t) (1- (mark t))))
            (active_region . ,(if (use-region-p) t :json-false))
            (mark_active . ,(if mark-active t :json-false))
            (error . ,issue)))))))
(defvar navigation-cases
