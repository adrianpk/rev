         ("group_negative_backward" c-mode "(a) (b)" 0 "C-u -2 C-M-p")
         ("up_negative" c-mode "(a (b))" 4 "C-u -1 C-M-u")
         ("down_no_group" c-mode "alpha" 0 "C-M-d")
         ("down_zero" c-mode "(a)" 0 "C-u 0 C-M-d")
         ("group_negative_region" c-mode "(a) (b)" 7 "C-u -2 C-M-n" :mark 0)
         ("group_lisp_comment" emacs-lisp-mode "; (hidden)\n(a)" 0 "C-M-n")
         ("group_plain_semicolon" fundamental-mode "; (hidden)\n(a)" 0 "C-M-n"))))
(princ (json-encode `((reference . "GNU Emacs without init") (version . ,emacs-version)
                      (cases . ,(vconcat (mapcar #'navigation-probe navigation-cases))))))
(terpri)
