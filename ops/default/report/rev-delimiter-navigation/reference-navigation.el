    ("sexp_readonly" c-mode "alpha beta" 0 "C-M-f" :readonly t)
    ("org_body_form" org-mode "* Heading\n(alpha) tail\n" 10 "C-M-f")
    ("org_body_group" org-mode "* Heading\n(alpha) tail\n" 10 "C-M-n")))
(setq navigation-cases
      (append navigation-cases
       '(("sexp_text_hyphen" text-mode "alpha-beta next" 0 "C-M-f")
         ("sexp_text_quote_prefix" text-mode "'alpha next" 0 "C-M-f")
         ("sexp_text_underscore" text-mode "alpha_beta next" 0 "C-M-f")
         ("sexp_plain_apostrophe" fundamental-mode "can't next" 0 "C-M-f")
         ("sexp_c_prefix" c-mode "*value + 7" 0 "C-M-f")
         ("sexp_c_double_colon" c-mode "foo::bar" 0 "C-M-f")
         ("sexp_js_identifier" js-mode "$value.next" 0 "C-M-f")
         ("sexp_css_identifier" css-mode "font-size: 12px" 0 "C-M-f")
         ("sexp_count_then_bad" c-mode "alpha (b" 0 "C-u 2 C-M-f")
         ("sexp_lisp_count_then_bad" emacs-lisp-mode "alpha (b" 0 "C-u 2 C-M-f")
         ("sexp_count_beyond_eof" c-mode "alpha" 0 "C-u 2 C-M-f")
         ("sexp_unterminated_string" c-mode "\"abc" 0 "C-M-f")
